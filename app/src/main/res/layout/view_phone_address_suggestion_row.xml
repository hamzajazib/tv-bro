<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the address suggestions of the phone bar: the favicon, the title and the address, or a search with
     the arrow that puts it into the field. Not focusable, so a tap leaves the focus (and the keyboard) in the
     address field. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/ds_phone_download_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/ds_phone_bookmark_row_padding"
    android:paddingEnd="@dimen/ds_phone_menu_row_padding"
    android:background="@drawable/ds_menu_row_bg"
    android:clickable="true"
    android:focusable="false">

  <ImageView
      android:id="@+id/ivIcon"
      android:layout_width="@dimen/ds_phone_quick_button_icon"
      android:layout_height="@dimen/ds_phone_quick_button_icon"
      android:scaleType="fitCenter"
      android:importantForAccessibility="no"
      tools:src="@drawable/ic_not_available" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:paddingTop="@dimen/ds_bookmark_row_text_padding"
      android:paddingBottom="@dimen/ds_bookmark_row_text_padding"
      android:layout_marginStart="@dimen/ds_phone_bookmark_icon_text"
      android:orientation="vertical">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/ds_text_phone_menu_item"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/tbColorDsInk"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="YouTube" />

    <TextView
        android:id="@+id/tvCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/ds_text_phone_caption"
        android:textColor="?attr/tbColorDsInk"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="www.youtube.com" />
  </LinearLayout>

  <ImageButton
      android:id="@+id/ibFill"
      android:layout_width="@dimen/ds_phone_download_row_height"
      android:layout_height="@dimen/ds_phone_download_row_height"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:focusable="false"
      android:scaleType="center"
      android:src="@drawable/ic_arrow_insert"
      android:contentDescription="@string/search_suggestion_fill"
      android:visibility="gone"
      app:tint="?attr/tbColorDsIcon" />
</LinearLayout>
